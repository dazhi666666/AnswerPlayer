# Copy these names into your shell environment before running the app.
# Never commit real values.
XUNFEI_APPID=your_xunfei_app_id
XUNFEI_API_KEY=your_xunfei_api_key
XUNFEI_API_SECRET=your_xunfei_api_secret
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Only needed for local activation-code administration.
ACTIVATION_ADMIN_SECRET=replace_with_a_long_random_value
